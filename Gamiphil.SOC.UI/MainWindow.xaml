<Window x:Class="Gamiphil.SOC.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamiphil SOC"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#E5E7EB">

	<Window.Resources>
		<SolidColorBrush x:Key="BackgroundBrush" Color="#0B1120"/>
		<SolidColorBrush x:Key="PanelBrush" Color="#111B2E"/>
		<SolidColorBrush x:Key="BorderBrush" Color="#263449"/>
		<SolidColorBrush x:Key="AccentBrush" Color="#20C9A6"/>
		<SolidColorBrush x:Key="MutedBrush" Color="#91A0B7"/>

		<Style x:Key="NavigationButton" TargetType="Button">
			<Setter Property="Foreground" Value="#B8C4D8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="16,12"/>
			<Setter Property="Margin" Value="0,3"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="MetricCard" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="20"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="245"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- LEFT NAVIGATION -->
		<Border Grid.Column="0"
                Background="#0E1728"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

			<DockPanel Margin="18">

				<StackPanel DockPanel.Dock="Top" Margin="0,8,0,28">
					<TextBlock Text="GAMIPHIL"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
					<TextBlock Text="SECURITY OPERATIONS"
                               FontSize="10"
                              
                               Foreground="{StaticResource MutedBrush}"
                               Margin="1,5,0,0"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="WORKSPACE"
                               Foreground="#687991"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,0,0,10"/>

					<Button Style="{StaticResource NavigationButton}"
                            Background="#183A42"
                            Foreground="#20C9A6"
                            Content="▦   Dashboard"/>

					<Button Style="{StaticResource NavigationButton}"
                            Content="◉   Security Alerts"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="≋   Security Events"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="▣   Endpoints"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="⌘   Network"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="⚙   Response Center"/>

					<TextBlock Text="MANAGEMENT"
                               Foreground="#687991"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,28,0,10"/>

					<Button Style="{StaticResource NavigationButton}"
                            Content="◎   Investigations"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="▤   Reports"/>
					<Button Style="{StaticResource NavigationButton}"
                            Content="⚙   Settings"/>
				</StackPanel>

				<Border DockPanel.Dock="Bottom"
                        Background="#111B2E"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,20,0,0">
					<StackPanel>
						<TextBlock Text="LAB ENVIRONMENT"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"/>
						<TextBlock Text="●  Local Development"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,8,0,0"
                                   FontSize="12"/>
					</StackPanel>
				</Border>
			</DockPanel>
		</Border>

		<!-- MAIN WORKSPACE -->
		<ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

			<StackPanel Margin="30">

				<DockPanel Margin="0,0,0,28">
					<StackPanel DockPanel.Dock="Left">
						<TextBlock Text="Security Overview"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
						<TextBlock Text="Monitor your security environment and investigate incidents."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,7,0,0"/>
					</StackPanel>

					<Border DockPanel.Dock="Right"
                            Background="#172A30"
                            BorderBrush="#24584F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            VerticalAlignment="Center">
						<TextBlock Text="●  LAB MODE"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
					</Border>
				</DockPanel>

				<!-- METRIC CARDS -->
				<UniformGrid Columns="4" Margin="0,0,0,24">

					<Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
						<StackPanel>
							<TextBlock Text="MANAGED ENDPOINTS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>
							<TextBlock Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,5"/>
							<TextBlock Text="No agents connected"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
						<StackPanel>
							<TextBlock Text="CRITICAL ALERTS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>
							<TextBlock Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="#FB7185"
                                       Margin="0,12,0,5"/>
							<TextBlock Text="No live alert feed"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
						<StackPanel>
							<TextBlock Text="OPEN INCIDENTS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>
							<TextBlock Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,5"/>
							<TextBlock Text="Incident tracking ready"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MetricCard}">
						<StackPanel>
							<TextBlock Text="PROTECTION STATUS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>
							<TextBlock Text="LAB"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,12,0,5"/>
							<TextBlock Text="Monitoring not connected"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
						</StackPanel>
					</Border>

				</UniformGrid>

				<!-- EVENT FEED -->
				<Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,20">

					<StackPanel>
						<DockPanel Margin="0,0,0,18">
							<TextBlock Text="Recent Security Events"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
							<TextBlock DockPanel.Dock="Right"
                                       Text="DEMONSTRATION DATA"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
						</DockPanel>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="SEVERITY"
                                       Grid.Column="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,12"/>
							<TextBlock Text="EVENT"
                                       Grid.Column="1"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,12"/>
							<TextBlock Text="SOURCE"
                                       Grid.Column="2"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,12"/>
							<TextBlock Text="STATUS"
                                       Grid.Column="3"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,12"/>
						</Grid>

						<Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,0,0,4"/>

						<Grid Margin="0,12,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="INFO"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="11"/>
							<TextBlock Grid.Column="1"
                                       Text="SOC workspace initialized"/>
							<TextBlock Grid.Column="2"
                                       Text="Local application"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
							<TextBlock Grid.Column="3"
                                       Text="DEMO"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
						</Grid>

						<Border Height="1"
                                Background="{StaticResource BorderBrush}"/>

						<TextBlock Text="Live security events will appear here when a monitoring source is connected."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"
                                   FontSize="12"/>
					</StackPanel>
				</Border>

				<!-- RESPONSE WORKSPACE -->
				<Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">

					<StackPanel>
						<TextBlock Text="Incident Response"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

						<TextBlock Text="Investigate, contain, remediate and verify — with controlled response actions."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

						<Border Background="#182437"
                                CornerRadius="8"
                                Padding="14">
							<StackPanel>
								<TextBlock Text="RESPONSE ENGINE"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"/>
								<TextBlock Text="Not connected"
                                           Foreground="#FBBF24"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
								<TextBlock Text="Response actions will remain unavailable until an authorized integration is configured."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="0,6,0,0"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>

				<TextBlock Text="GAMIPHIL SOC  •  DEVELOPMENT BUILD"
                           Foreground="#687991"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           Margin="0,22,0,0"/>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
